# Public site URL for Open Graph and PWA (no trailing slash). Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=

# Optional. Without a key the free CoinGecko tier is used (last 365 days only, tight rate limits).
COINGECKO_API_KEY=
# "demo" (default) or "pro". Only a paid "pro" key unlocks history older than 365 days.
COINGECKO_PLAN=demo

# Needed only for the Share button. A Neon Postgres connection string (Vercel Marketplace > Neon sets it for you).
# The `shares` table is created automatically on first use.
DATABASE_URL=

# Optional. DexHunter's chart API (used to fill older Cardano months) answered without a key when tested, but
# its docs ask for one. If it starts returning 401, get a free partner key at app.dexhunter.io/partners.
DEXHUNTER_PARTNER_ID=

# Optional. Stock prices come from Yahoo Finance, which rate-limits shared server addresses. If it blocks yours,
# point this at a proxy that forwards to Yahoo (comma-separated for several). Default: Yahoo directly.
YAHOO_BASE_URL=

# Optional. Protect the public /api/v1 API: comma-separated keys. If set, requests must send one as
# `Authorization: Bearer <key>` or `x-api-key: <key>`. Unset = open to everyone (rate limited).
DCA_API_KEYS=
# Requests per minute per caller. Defaults: 30 without a key, 120 with one.
DCA_API_RATE_LIMIT_ANON=
DCA_API_RATE_LIMIT_KEY=

# Optional. The admin page at /admin (not linked anywhere): the subscriber list, and the access codes with the Tiingo keys they use.
# ADMIN_PASSWORD must be 8 or more characters. It also encrypts the Tiingo keys saved there, so changing it means adding them again.
# Needs DATABASE_URL.
ADMIN_PASSWORD=

# Optional. Sign-in by emailed link (no passwords). Needs DATABASE_URL and a Resend account (resend.com) with a verified sender.
# Without these, signing in is off on the live site (in local development the link is shown on screen instead).
RESEND_API_KEY=
MAIL_FROM=

# Optional. An invisible "are you a person" check for anonymous visitors, from Cloudflare Turnstile (free). Both keys are needed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. How many times someone can run "See what it's worth" in a day, and per minute. Defaults: 20 anonymous, 150 signed in,
# 1000 for someone with an access code; the per-minute ceilings are 10 anonymous and 30 otherwise.
RUN_LIMIT_ANON_DAY=
RUN_LIMIT_USER_DAY=
RUN_LIMIT_TRUSTED_DAY=
RUN_LIMIT_ANON_MINUTE=
RUN_LIMIT_MINUTE=

# Optional. Press Cmd+K (Ctrl+K) on the site and enter ACCESS_CODE (exactly four digits) to let that browser use TIINGO_API_KEY
# for stock prices when Yahoo Finance refuses. The key stays on the server. Both must be set. Anyone who knows the code can use
# your key's quota, and Tiingo's free plan is for personal use, so share the code only with people you trust.
ACCESS_CODE=
TIINGO_API_KEY=
